// code for singly linkedlist where i have to find the intersection , union , difference in them 
#include <iostream>
using namespace std;

struct Node {
    Node* next;
    int data;
};

void insert(Node*& head, int value) {
    Node* newNode = new Node;
    newNode->data = value;
    newNode->next = NULL;

    if (head == NULL) {
        head = newNode;
        return;
    }

    Node* temp = head;

    while (temp->next != NULL) {
        temp = temp->next;
    }

    temp->next = newNode;
}

bool search(Node* head, int value) {
    while (head != NULL) {
        if(head->data == value) {
            return true;
        }
        head = head->next;
    }
    return false;
}


void display(Node* head){
    while (head != NULL) {
        cout << head->data << " ";
        head = head->next;
    }
    cout << endl;
}

Node* unionSet(Node* A, Node* B) {
    Node* result = NULL;

    while (A != NULL) {
        insert(result, A->data);
        A = A->next;
    }

    while (B != NULL) {
        if (!search(result, B->data)) {
            insert(result, B->data);
            B = B->next;
        }
        B = B->next;
    }
    return result;
}

Node* intersection(Node* A, Node* B) {
    Node* result = NULL;
    while (A !=NULL) {
        if (search(B, A->data)) {
            insert(result, A->data);
        }
        A = A->next;
    }
    return result;
}

Node* difference(Node* A, Node* B) {
    Node* result = NULL;
    while (A !=NULL) {
        if (!search(B, A->data)) {
            insert(result, A->data);
        }
        A = A->next;
    }
    return result;
}


int count(Node* head) {
    int count = 0;
    while (head != NULL) {
        count += 1;
        head = head->next;
    }
    return count;
}

int main() {
