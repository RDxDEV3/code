#include <iostream>
using namespace std;

struct Node {
    int data;
    Node* next;
    Node* prev;
};


void insert(Node*& head, Node*& tail, int value) {
    Node* newNode = new Node(value, NULL , NULL);

    if (head == NULL) {
        head = tail = newNode;
    }
    else {
        tail->next = newNode;
        newNode->prev = tail;
        tail = newNode;
    }
}

Node* ones(Node* head) {
    Node* result = NULL;
    Node* resultTail = NULL;

    while(head != NULL) {
        insert(result, resultTail, 1 - head->data);
        head = head->next;
    }
    return result;
}

void twos(Node* head) {
    // ones(head);

    Node* temp = head;
    while (temp->next != NULL) {
        temp = temp->next;
    }

    int carry = 1;

    while (temp != NULL && carry == 1) {
        if (temp->data == 0) {
            temp->data = 1;
            carry = 0;
        } else {
            temp->data = 0;
            temp = temp->prev;
        }
    }
}

void display(Node* head) {
    while(head != NULL) {
        cout << head->data << " ";
        head = head->next;
    }
    cout << endl;
}
