# Check properties of a relation

A = {1, 2, 3}
R = {(1,1), (2,2), (3,3), (1,2), (2,1)}

# Reflexive
reflexive = True
for a in A:
    if (a,a) not in R:
        reflexive = False

# Symmetric
symmetric = True
for (a,b) in R:
    if (b,a) not in R:
        symmetric = False

# Transitive
transitive = True
for (a,b) in R:
    for (c,d) in R:
        if b == c and (a,d) not in R:
            transitive = False

# Equivalence
equivalence = reflexive and symmetric and transitive

print("Reflexive:", reflexive)
print("Symmetric:", symmetric)
print("Transitive:", transitive)
print("Equivalence:", equivalence)
