# Program to implement Set Operations

# Create two sets
A = {1, 2, 3, 4, 5}
B = {4, 5, 6, 7, 8}

print("Set A:", A)
print("Set B:", B)

# 1. Union
print("Union:", A.union(B))

# 2. Intersection
print("Intersection:", A.intersection(B))

# 3. Difference
print("Difference (A - B):", A.difference(B))

# 4. Cartesian Product
cartesian_product = [(x, y) for x in A for y in B]
print("Cartesian Product:", cartesian_product)

