# Program to calculate Gradient, Divergence and Curl

import sympy as sp

# Define variables
x, y, z = sp.symbols('x y z')

# Scalar field
f = x**2 + y**2 + z**2

# Vector field
F = [x*y, y*z, z*x]

# Gradient
gradient = [sp.diff(f, x), sp.diff(f, y), sp.diff(f, z)]

# Divergence
divergence = sp.diff(F[0], x) + sp.diff(F[1], y) + sp.diff(F[2], z)

# Curl
curl = [
    sp.diff(F[2], y) - sp.diff(F[1], z),
    sp.diff(F[0], z) - sp.diff(F[2], x),
    sp.diff(F[1], x) - sp.diff(F[0], y)
]

# Display results
print("Gradient:", gradient)
print("Divergence:", divergence)
print("Curl:", curl)

# Analyze the field
if divergence == 0:
    print("Field is Solenoidal")
else:
    print("Field is not Solenoidal")

if curl == [0, 0, 0]:
    print("Field is Irrotational")
else:
    print("Field is not Irrotational")

