#include <iostream>
#include <stack>
#include <string>
using namespace std;

//checking for the string is palindrome or not 
bool palindrome(string s) {
    stack<char> st;

    for (char c : s) {
        st.push(c);
    }

    for (char c : s) {
        if (c != st.top()) 
            return false;
        st.pop();
    }
    return true;
}

string cleanString(string s) {
    stack<char> st;
    string result = "";

    for (char c: s) {
        if (isalnum(c)) {
            result += tolower(c);
        }
    }
    return result;
}

void  reversedString(string s) {
    stack<char> st;

    for (char c : s)
        st.push(c);

    cout << "Reverse string: ";

    while (!st.empty()) {
        cout << st.top();
        st.pop();
    }

    cout << endl;
}

int main() {
    string s = "MADAM";
        // Clean string
    string clean = cleanString(s);

    cout << "Cleaned string: " << clean << endl;

    // Check palindrome
    if (palindrome(clean))
        cout << "String is Palindrome" << endl;
    else
        cout << "String is not Palindrome" << endl;

    // Reverse string
    reversedString(s) ;
    return 0;
}


