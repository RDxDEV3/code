#include <iostream>
#include <stack>
#include <string> 
using namespace std;

int prority(char ch) {
    if (ch == '*' || ch == '/') {
        return 2;
    }
    return 1;
}

string postfix(string s) {
    stack<char> st;
    string post = "";

    for (char ch : s) {
        if (ch >= '0' && ch <= '9') {
            post += ch;
        } else {
            while (!st.empty() && prority(st.top()) >= prority(ch)) {
                post += st.top();
                st.pop();
            }
            st.push(ch);
        }
    }
    while (!st.empty()){
        post += st.top();
        st.pop();
    }
    return post;
}

int calcuation(string s) {
    stack<int> st;
    for (char ch :s) {
        if (ch >= '0' && ch <= '9')
            st.push(ch - '0');
        else {
            int b = st.top();
            st.pop();

            int a =  st.top();
            st.pop();

            if (ch == '+') st.push(a + b);
            if (ch == '-') st.push(a - b);
            if (ch == '*') st.push(a * b);
            if (ch == '/') st.push(a / b);
        }
    }
    return st.top();
}

int main() {
    string s;
    cout << "the calculation in string using the operators like /*-+ " ;
    cin >> s;

    string infixanswer = postfix(s);
    cout << infixanswer << endl;

    
    cout << calcuation(infixanswer) << endl;

}
