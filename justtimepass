# Check Injective, Surjective and Bijective functions

A = {1, 2, 3}
B = {2, 4, 6}

# Function mapping
f = {1: 2, 2: 4, 3: 6}

print("Domain:", A)
print("Codomain:", B)
print("Mapping:", f)

# Injective
injective = len(set(f.values())) == len(A)

# Surjective
surjective = set(f.values()) == B

# Bijective
bijective = injective and surjective

print("Injective:", injective)
print("Surjective:", surjective)
print("Bijective:", bijective)


