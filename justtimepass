# Calculate Mean, Median and Mode

data = [10, 20, 20, 30, 40, 50, 20]

# Mean
mean = sum(data) / len(data)

# Median
sorted_data = sorted(data)
n = len(data)

if n % 2 == 0:
    median = (sorted_data[n//2 - 1] + sorted_data[n//2]) / 2
else:
    median = sorted_data[n//2]

# Mode
mode = max(data, key=data.count)

print("Dataset:", data)
print("Mean:", mean)
print("Median:", median)
print("Mode:", mode)


